---
import DefaultHead from '@astrojs/starlight/components/Head.astro';
import { ClientRouter } from 'astro:transitions';

declare global {
	interface Window {
		dataLayer: IArguments[];
	}
}
---

<DefaultHead />
<script async src="https://www.googletagmanager.com/gtag/js?id=G-MR7GQ0MR56"></script>
<script is:inline>
	window.dataLayer = window.dataLayer || [];
	function gtag() {
		window.dataLayer.push(arguments);
	}
	gtag('js', new Date());
	gtag('config', 'G-MR7GQ0MR56');
</script>
<ClientRouter />
