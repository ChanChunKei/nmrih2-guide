    {
      "id": "fact:mission-types",
      "statement": "Objective missions use large maps and linear tasks; Survival missions defend speaker systems through up to three waves.",
      "claim_type": "fact",
      "verification_rule": "official_single",
      "freshness_class": "stable",
      "source_ids": [
        "source:official-launch"
      ],
