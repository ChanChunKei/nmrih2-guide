    },
    {
      "id": "fact:infection",
      "statement": "Phalanx pills delay infection and have three doses per bottle; one experimental gene therapy can spawn per match and cures infection with immunity.",
      "claim_type": "fact",
      "verification_rule": "official_single",
      "freshness_class": "stable",
      "source_ids": [
        "source:official-launch"
      ],
