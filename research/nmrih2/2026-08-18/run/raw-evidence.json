      "conflict": false
    },
    {
      "id": "fact:extraction",
      "statement": "Early extraction preserves a Responder but grants only a small Credit share and no character progression; final extraction awards the team-supply result.",
      "claim_type": "fact",
      "verification_rule": "official_single",
      "freshness_class": "stable",
      "source_ids": [
